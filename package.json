{
  "name": "@nightsquawktech/mcp-core",
  "version": "0.3.0",
  "description": "Shared runtime for NightSquawk catalog-backed MCP servers: stdio bootstrap, catalog primitives, and the guard (tiers, policy, approvals, audit).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./guard": {
      "types": "./dist/guard/index.d.ts",
      "default": "./dist/guard/index.js"
    },
    "./guard/testing": {
      "types": "./dist/guard/testing/index.d.ts",
      "default": "./dist/guard/testing/index.js"
    }
  },
  "bin": {
    "mcp-guard": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COMMERCIAL.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:coverage": "npm run build && node scripts/run-tests.mjs --experimental-test-coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.18.0 <2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.0",
    "zod": "^3.25.0"
  },
  "author": "Kevin Reyes (NightSquawk Tech) <hello@nightsquawk.tech>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NightSquawk/mcp-core.git"
  },
  "homepage": "https://github.com/NightSquawk/mcp-core#readme",
  "bugs": {
    "url": "https://github.com/NightSquawk/mcp-core/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
